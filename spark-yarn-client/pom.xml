<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.apache.spark</groupId>
    <artifactId>spark-parent_2.12</artifactId>
    <version>3.5.9-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>spark-yarn-client_2.12</artifactId>
  <packaging>jar</packaging>
  <name>Spark YARN Client</name>
  <url>https://spark.apache.org/</url>
  <description>
    Lightweight Java client for submitting Spark jobs to YARN without a local Spark installation.
    Replicates spark-submit YARN cluster submission directly via Hadoop YARN API.
    Supports HDFS fat-JAR upload and Kerberos authentication.
  </description>

  <properties>
    <sbt.project.name>yarn-client</sbt.project.name>
  </properties>

  <dependencies>
    <!-- ===== Main dependencies ===== -->

    <!--
      hadoop-common: Configuration, UserGroupInformation (Kerberos).
      hadoop-hdfs-client: FileSystem / HDFS client.
      hadoop-yarn-client: YarnClient, ContainerLaunchContext, LocalResource, etc.
      All scoped to ${hadoop.deps.scope} (defaults to "compile"; "provided" in Spark distributions).
    -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-common</artifactId>
      <version>${hadoop.version}</version>
      <scope>${hadoop.deps.scope}</scope>
      <exclusions>
        <exclusion>
          <groupId>log4j</groupId>
          <artifactId>log4j</artifactId>
        </exclusion>
        <exclusion>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-log4j12</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-hdfs-client</artifactId>
      <version>${hadoop.version}</version>
      <scope>${hadoop.deps.scope}</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-yarn-client</artifactId>
      <!-- version managed in parent dependencyManagement -->
      <scope>${hadoop.deps.scope}</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <!-- version managed in parent dependencyManagement -->
    </dependency>

    <!-- ===== Test dependencies ===== -->

    <!-- JUnit 5 (not yet in parent dependencyManagement) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.1</version>
      <scope>test</scope>
    </dependency>

    <!-- Testcontainers: Docker-based Hadoop (HDFS + YARN) and KDC containers -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>1.20.6</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>1.20.6</version>
      <scope>test</scope>
    </dependency>

    <!-- Real Spark AM and executor classes for integration tests.
         These JARs are bind-mounted into the Hadoop Docker container so
         YARN containers have Spark classes on their classpath. -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-core_2.12</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-yarn_2.12</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- HDFS client classes needed at test compile time (FileSystem, Path, etc.
         are in hadoop-hdfs-client which is a main dependency; server-side classes
         for MiniDFS/MiniYARN are no longer needed since we use Docker) -->

    <!-- Logging for tests -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    No surefire overrides needed: the parent pom provides -Xmx4g and all
    required JVM module-opens flags via the extraJavaTestArgs property.
    Integration tests (MiniDFS + MiniYARN) run under maven-surefire-plugin,
    exactly as spark-yarn does in resource-managers/yarn.
  -->


</project>
